#!/bin/bash
PORT=22
HOST=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) PORT="$2"; shift 2 ;;
    -T|-t) shift 2 ;;
    --) shift; HOST="$1"; shift ;;
    *) HOST="$1"; shift ;;
  esac
done
[ -n "$FAKE_SFTP_LOG" ] && printf 'KEYSCAN %s %s\n' "$HOST" "$PORT" >> "$FAKE_SFTP_LOG"
if [ -z "$FAKE_SFTP_HOSTKEY" ]; then exit 1; fi
if [ "$PORT" = "22" ]; then NAME="$HOST"; else NAME="[$HOST]:$PORT"; fi
echo "# $HOST:$PORT SSH-2.0-OpenSSH_fake" >&2
printf '%s ssh-ed25519 %s\n' "$NAME" "$FAKE_SFTP_HOSTKEY"
