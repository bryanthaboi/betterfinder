{
  "id": "system7",
  "name": "System 7",
  "base": "light",
  "colors": {
    "windowBg": "#FFFFFF",
    "listBg": "#FFFFFF",
    "rowAlt": "",
    "selection": "#000000",
    "selectionText": "#FFFFFF",
    "text": "#000000",
    "secondaryText": "#000000",
    "sidebarBg": "#FFFFFF",
    "sidebarText": "#000000",
    "statusBarBg": "#FFFFFF",
    "statusBarText": "#000000",
    "toolbarBg": "#FFFFFF",
    "accent": "#000000",
    "border": "#000000",
    "inactiveSelection": "#000000",
    "inactiveSelectionText": "#FFFFFF",
    "sidebarSelection": "#000000",
    "sidebarSelectionText": "#FFFFFF",
    "toolbarText": "#000000",
    "sidebarIcon": "#000000"
  },
  "fonts": {
    "list": {
      "family": "Geneva, system",
      "size": 12
    },
    "ui": {
      "family": "Geneva, system",
      "size": 11
    },
    "sidebar": {
      "family": "ChicagoFLF, Chicago, Charcoal, Geneva, system",
      "size": 12
    },
    "statusBar": {
      "family": "Geneva, system",
      "size": 11
    }
  },
  "metrics": {
    "rowHeight": 18,
    "cornerRadius": 0,
    "bevel": "none",
    "borderWidth": 0,
    "statusBarHeight": 20,
    "listIconSize": 16,
    "sidebarRowHeight": 20,
    "pathBarHeight": 24,
    "selectionInset": 0,
    "selectionVerticalInset": 0,
    "cellHorizontalInset": 4,
    "iconTextGap": 4,
    "iconGridGapH": 8,
    "iconGridGapV": 12,
    "iconGridInset": 12,
    "defaultDensity": "compact"
  },
  "chrome": {
    "titlebar": "lines",
    "toolbarStyle": "bevel",
    "scrollbar": "system7",
    "useNativeChrome": false
  },
  "window": {
    "titlebar": "lines",
    "colors": [
      "#FFFFFF",
      "#000000"
    ],
    "inactiveColors": [
      "#FFFFFF"
    ],
    "titleColor": "#000000",
    "inactiveTitleColor": "#000000",
    "titleAlignment": "center",
    "titleFont": {
      "family": "ChicagoFLF, Chicago, Charcoal, Geneva, system",
      "size": 12,
      "weight": "bold"
    },
    "buttons": "classicBoxes",
    "buttonFace": "#FFFFFF",
    "buttonGlyph": "#000000",
    "buttonBevel": false,
    "buttonSize": 11,
    "showsMinimize": false,
    "frameColor": "#000000",
    "separator": true
  },
  "toolbar": {
    "style": "bevel",
    "surface": "flat",
    "background": "#FFFFFF",
    "text": "#000000",
    "buttonFace": "#FFFFFF",
    "buttonBorder": "#000000",
    "hover": "#FFFFFF",
    "pressed": "#000000",
    "cornerRadius": 5
  },
  "header": {
    "style": "flat",
    "background": "#FFFFFF",
    "text": "#000000",
    "separator": "#000000",
    "sortIndicator": "#000000",
    "height": 18,
    "font": {
      "family": "Geneva, system",
      "size": 11
    }
  },
  "pathBar": {
    "style": "flat",
    "background": "#FFFFFF",
    "text": "#000000",
    "separator": "#000000",
    "highlight": "#000000"
  },
  "surfaces": {
    "statusBar": "flat",
    "sidebar": "flat",
    "list": "native"
  },
  "grid": {
    "horizontal": false,
    "vertical": false,
    "color": "#000000",
    "style": "dotted",
    "width": 1
  },
  "iconLabels": {
    "text": "#000000",
    "background": "#FFFFFF",
    "selectionBackground": "#000000",
    "selectionText": "#FFFFFF",
    "shape": "rect",
    "maxLines": 2
  },
  "scrollbar": {
    "style": "system7",
    "track": "#000000",
    "thumb": "#FFFFFF",
    "thumbBorder": "#000000",
    "arrows": true,
    "width": 16,
    "minimumThumb": 16
  },
  "bevelColors": {
    "face": "#FFFFFF",
    "highlight": "#FFFFFF",
    "light": "#FFFFFF",
    "shadow": "#FFFFFF",
    "darkShadow": "#000000",
    "frame": "#000000"
  },
  "desktopPattern": {
    "kind": "dither50",
    "foreground": "#000000",
    "background": "#FFFFFF",
    "scale": 1
  },
  "icons": {
    "set": "system"
  },
  "sounds": {}
}
