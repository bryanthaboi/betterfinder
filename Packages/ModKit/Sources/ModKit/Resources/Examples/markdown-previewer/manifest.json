{
  "manifestVersion": 1,
  "id": "alice.markdown-previewer",
  "name": "Markdown Previewer",
  "author": "alice",
  "version": "1.0.0",
  "api": ">=1.0.0 <2.0.0",
  "app": ">=1.0.0 <2.0.0",
  "runtime": "jsc-ir/1",
  "entry": "scripts/main.bfscript.json",
  "license": "MIT",
  "permissions": [
    {"kind": "fs.read", "scope": "selection", "recursive": false, "reason": "Read the Markdown file being previewed"},
    {"kind": "ui", "surfaces": ["preview"]}
  ],
  "contributes": {
    "previews": [{"id": "markdown", "title": "Markdown", "extensions": ["md", "markdown"], "handler": "renderMarkdown"}]
  },
  "hooks": [{"name": "preview.render", "handler": "renderMarkdown", "version": 1}],
  "settings": [],
  "dependencies": [],
  "conflicts": []
}
